# Database
POSTGRES_USER=yarrow
POSTGRES_PASSWORD=yarrow_password
POSTGRES_DB=yarrow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Task Queue
VALKEY_HOST=valkey
VALKEY_PORT=6379
CELERY_BROKER_URL=redis://valkey:6379/0

# Object Storage
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=yarrow-documents
USE_LOCAL_STORAGE=false

# Auth & Secrets
SECRET_KEY=supersecretkey_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Inference Endpoints
INFERENCE_SERVICE_URL=http://inference:8000
INFERENCE_API_KEY=mock_key
USE_MOCK_INFERENCE=true

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
