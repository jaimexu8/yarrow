# Database
POSTGRES_USER=yarrow
POSTGRES_PASSWORD=yarrow_password
POSTGRES_DB=yarrow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Task Queue
VALKEY_HOST=valkey
VALKEY_PORT=6379
CELERY_BROKER_URL=redis://valkey:6379/0

# Object Storage
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=yarrow-documents
USE_LOCAL_STORAGE=false

# Auth & Secrets
SECRET_KEY=supersecretkey_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set to true wherever the app is served over HTTPS: redirects plain HTTP and
# tells browsers to always use HTTPS. Leave false for local http://localhost.
ENFORCE_HTTPS=false
# Behind a TLS-terminating proxy, set this to the proxy's IP address(es), so
# uvicorn trusts its X-Forwarded-Proto header. Without it, HTTPS requests look
# like plain HTTP and ENFORCE_HTTPS redirects forever. Never use "*" unless
# only the proxy can reach the backend.
FORWARDED_ALLOW_IPS=127.0.0.1

# Inference Endpoints
# Defaults to the mock gateway service in docker-compose, which needs no GPU.
# Point this at the real cluster (e.g. http://dgx:8080/layout-parsing) to use it.
INFERENCE_SERVICE_URL=http://gateway:8080/layout-parsing
# Leave empty for the mock. Real keys belong in .env, which is not committed --
# never in this file.
INFERENCE_API_KEY=
# Comma-separated 1-based page numbers the mock gateway should fail with a 503,
# for exercising per-page failure isolation. Empty means every page succeeds.
MOCK_FAIL_PAGES=
# 503 is retryable (the worker recovers that page); 400 fails it permanently.
MOCK_FAIL_STATUS=503
GATEWAY_PORT=8080

# Email (compose runs Mailpit; UI at http://localhost:8025). With SMTP_HOST
# empty nothing is sent; set LOG_EMAIL_BODIES=true to print emails (including
# codes and reset links) to the backend log. Local development only.
SMTP_HOST=mailpit
LOG_EMAIL_BODIES=false
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=Yarrow <no-reply@yarrow.local>
VERIFICATION_CODE_TTL_MINUTES=15
# Wrong guesses allowed per code; resend cooldown; codes sent per hour.
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_SENDS_PER_HOUR=5
# Password reset: link lifetime; seconds between reset emails; emails per hour.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=3

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upload limits
STORAGE_QUOTA_BYTES=1073741824
MAX_UPLOAD_BYTES=268435456

# Cloud Storage Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
