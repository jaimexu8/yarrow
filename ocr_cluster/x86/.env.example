# nginx edge API key (X-API-Key or Authorization: Bearer). Generate one with:
#   openssl rand -hex 32
GATEWAY_API_KEY=mock_key

# Model identity headers the gateway stamps on /layout-parsing responses.
MODEL_NAME=PP-StructureV3+PaddleOCR-VL
MODEL_VERSION=3.2.0+vl-0.9b

# Bearer key the gateway sends to the structure service (ort-structure) on
# /layout-parsing.
# The ort-structure service validates against the same key. Generate one with:
#   openssl rand -hex 32
STRUCTURE_API_KEY=mock_structure_key
