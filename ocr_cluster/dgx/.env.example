GATEWAY_API_KEY=0393cfe332d8270085fe680a640e237ed03db41682987d1dcb2e60eb3caeca62
MODEL_NAME=PP-StructureV3+PaddleOCR-VL
MODEL_VERSION=3.2.0+vl-0.9b

# ---- Gateway knobs (optional; values below are the compose defaults) ----
# OpenAI-compatible VLM base URL; default is the local SGLang/vLLM server.
#VLM_URL=http://vlm-server:8000/v1
# Model name override; unset auto-detects via GET /v1/models.
#VLM_MODEL=
# Global concurrent VLM calls; keep <= server --max-running-requests (16).
#VLM_MAX_INFLIGHT=16
# Completion token budget per crop; leave context headroom for image tokens.
#VLM_MAX_COMPLETION_TOKENS=8192
# JPEG quality for the crop sent to the VLM; 75 matches the pipeline encode.
#VLM_JPEG_QUALITY=75
# Gateway structure-stage inflight cap; keep <= ort-structure's own cap (2).
#STRUCTURE_MAX_INFLIGHT=2
# Seconds waiting for a structure slot before 503 + Retry-After.
#STRUCTURE_QUEUE_TIMEOUT=120
# Per-page deadline in seconds; below the worker's 540 s HTTP timeout.
#GATEWAY_DEADLINE=480
# JSON per-label pixel budgets for vLLM mm_processor_kwargs; unset sends none.
#VLM_PIXEL_BUDGETS=
# Per-call httpx timeout in seconds; just above ort-structure's 280 s timeout.
#REQUEST_TIMEOUT=300
